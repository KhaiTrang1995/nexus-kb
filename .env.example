# ==============================================================================
# Nexus-KB - Enterprise Knowledge Hub Configuration Template
# ==============================================================================
#
# This file contains the template configuration for running Nexus-KB.
# Copy this file to '.env' in the root directory and modify it as needed.
#
#   $ cp .env.example .env
#
# WARNING: Do not commit your actual '.env' file containing secrets or database
# credentials to source control. Refer to AGENTS.md for security practices.
#
# ==============================================================================

# ==============================================================================
# 1. POSTGRESQL DATABASE CONFIGURATION
# ==============================================================================
# Connection details for PostgreSQL metadata and audit logging.
# Used by SQLAlchemy, Alembic migrations, and the FastAPI service.

# Database Hostname
# - Use 'localhost' for local direct execution.
# - Use 'postgres' when running within the Docker Compose network.
POSTGRES_HOST=localhost

# Database Port (Default: 5432)
POSTGRES_PORT=5432

# Database Name
POSTGRES_DB=nexus_kb

# Database Owner/User
POSTGRES_USER=nexus

# Database Password
# WARNING: Change this value to a strong unique secret for staging/production!
POSTGRES_PASSWORD=change-me

# PostgreSQL Data Source Name (DSN)
# Format: postgresql+driver://user:password@host:port/database
# For SQLAlchemy, prefer the psycopg v3 driver (postgresql+psycopg://)
POSTGRES_DSN=postgresql+psycopg://nexus:change-me@localhost:5432/nexus_kb


# ==============================================================================
# 2. QDRANT VECTOR DATABASE CONFIGURATION
# ==============================================================================
# Configuration for the high-availability vector database.
# Used to query and index semantic chunks.

# Qdrant Hostname
# - Use 'localhost' for local direct execution.
# - Use 'qdrant' when running within the Docker Compose network.
QDRANT_HOST=localhost

# Qdrant HTTP REST API Port (Default: 6333)
QDRANT_HTTP_PORT=6333

# Qdrant gRPC API Port (Default: 6334)
QDRANT_GRPC_PORT=6334

# Qdrant Collection Name
# The name of the collection where knowledge chunks and embeddings are stored.
QDRANT_COLLECTION=nexus_chunks


# ==============================================================================
# 3. AI & EMBEDDING MODEL CONFIGURATION
# ==============================================================================
# Configuration for local sentence-transformers models.

# Embedding Model Identifier
# Supported: Hugging Face repository ID or local filesystem path to model weights.
# - Default 'BAAI/bge-m3' is a multilingual model providing high-quality dense/sparse embeddings.
NEXUS_EMBEDDING_MODEL=BAAI/bge-m3

# Vector Dimensions
# Must match the output dimension of the selected embedding model.
# - For BAAI/bge-m3: 1024
# - For all-MiniLM-L6-v2: 384
NEXUS_EMBEDDING_DIMENSION=1024


# ==============================================================================
# 4. TESTING & RUNTIME FLAGS
# ==============================================================================
# Control options for running tests and operational behavior.

# Live Service Testing (0 = Disabled, 1 = Enabled)
# When set to 1, pytest will attempt to run integration tests requiring
# live Docker services (PostgreSQL and Qdrant).
NEXUS_KB_RUN_LIVE_TESTS=0
